# VB-OS Cloud
VBOS_URL=https://api.vb-os.org
VBOS_API_KEY=
VBOS_PROJECT_ID=
VBOS_ENVIRONMENT_ID=

# Local source systems
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=vbos
ORTHANC_PASSWORD=imaging_dev
FHIR_URL=http://localhost:8090/fhir

# OpenAI — only needed if running bootstrap.py standalone.
# The connector credential is configured in the console (see SETUP.md step 1.4).
OPENAI_API_KEY=
INFERENCE_MODEL_ID=gpt-4o-2024-08-06

# Delivery drift — set >0 to simulate portal delivering fewer instances
# than authorized, causing E3 to DEFER
DELIVERY_DRIFT=0
